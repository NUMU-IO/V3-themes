{
  "type": "tn-bundle-banner",
  "name": "Bundle promo banner",
  "name_ar": "بانر عرض الباندل",
  "limit": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "The black promo strip. Designed to be reused — put it on the homepage, on every collection and above the product page footer. It is a link, not a calculator: the actual discount is applied by your promotion rules at checkout.",
      "content_ar": "الشريط الأسود بتاع العرض. متعمل عشان يتكرر — حطه في الرئيسية وفي كل تصنيف وفوق فوتر صفحة المنتج. هو مجرد لينك مش حاسبة: الخصم الحقيقي بيتحسب من قواعد العروض عند الدفع."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "label_ar": "الكلمة الصغيرة",
      "default": "SUMMER BUNDLE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "label_ar": "العنوان",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "subcopy",
      "label": "Subtext",
      "label_ar": "النص",
      "default": "Four bundles. Save up to 20%."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "label_ar": "نص الزرار",
      "default": "Customise my bundle"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "label_ar": "رابط الزرار",
      "default": "/pages/build-a-bundle"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Discount badge",
      "label_ar": "شارة الخصم",
      "default": "20% OFF",
      "info": "The lime pill on the button. Leave empty to hide it.",
      "info_ar": "الشارة الليموني على الزرار. سيبها فاضية عشان تختفي."
    },

    { "type": "header", "content": "Collage", "content_ar": "الصور" },
    {
      "type": "paragraph",
      "content": "Up to three product shots, overlapped like a hand of cards. Use cut-outs or tight crops — full scenes turn to mush at this size.",
      "content_ar": "لحد تلات صور منتجات، متراكبين زي الكوتشينة. استخدم صور مقصوصة أو قريبة — المشاهد الكاملة مش بتبان في الحجم ده."
    },
    { "type": "image_picker", "id": "collage_image_1", "label": "Image 1", "label_ar": "صورة 1", "default": "" },
    { "type": "image_picker", "id": "collage_image_2", "label": "Image 2", "label_ar": "صورة 2", "default": "" },
    { "type": "image_picker", "id": "collage_image_3", "label": "Image 3", "label_ar": "صورة 3", "default": "" },

    { "type": "header", "content": "Appearance", "content_ar": "الشكل" },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "label_ar": "الخلفية",
      "default": "ink",
      "options": [
        { "value": "ink", "label": "Black", "label_ar": "أسود" },
        { "value": "cream", "label": "Cream", "label_ar": "كريمي" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle promo banner",
      "name_ar": "بانر عرض الباندل",
      "settings": {
        "eyebrow": "SUMMER BUNDLE",
        "heading": "Build your bundle",
        "subcopy": "Four bundles. Save up to 20%.",
        "cta_text": "Customise my bundle",
        "cta_link": "/pages/build-a-bundle",
        "badge_text": "20% OFF",
        "surface": "ink"
      }
    }
  ]
}
