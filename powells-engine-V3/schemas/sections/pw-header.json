{
  "type": "pw-header",
  "name": "Masthead",
  "name_ar": "الهيدر",
  "settings": [
    {
      "type": "paragraph",
      "content": "One band with your logo, a wide search field, and the wishlist, account and cart buttons; the menu sits in a row beneath. Leave the menu links empty and the store's own menu is used instead.",
      "content_ar": "شريط واحد فيه اللوجو وخانة بحث عريضة وأزرار المفضلة والحساب والسلة؛ والقائمة في صف تحته. سيب لينكات القائمة فاضية وهيستخدم قائمة متجرك الأصلية."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "label_ar": "اللوجو",
      "default": "",
      "info": "Leave empty to show the shop name in the Powells lockup.",
      "info_ar": "سيبه فاضي عشان يظهر اسم المحل بشكل باول."
    },
    {
      "type": "checkbox",
      "id": "show_name_with_logo",
      "label": "Show the shop name next to the logo",
      "label_ar": "إظهار اسم المحل جنب اللوجو",
      "default": false
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Shop name",
      "label_ar": "اسم المحل",
      "default": "",
      "info": "Leave empty to use the store name.",
      "info_ar": "سيبه فاضي عشان يستخدم اسم المتجر."
    },
    {
      "type": "text",
      "id": "strapline",
      "label": "Under the name",
      "label_ar": "تحت الاسم",
      "default": "CITY of BOOKS"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "label_ar": "نص خانة البحث",
      "default": ""
    },
    {
      "type": "text",
      "id": "menu_handle",
      "label": "Menu to use",
      "label_ar": "القائمة المستخدمة",
      "default": "main-menu",
      "info": "Only used when you have not added menu links below.",
      "info_ar": "بيستخدم بس لو مضفتش لينكات تحت."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "label_ar": "إظهار البحث",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show the wishlist button",
      "label_ar": "إظهار زر المفضلة",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show the account button",
      "label_ar": "إظهار زر الحساب",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show the cart button",
      "label_ar": "إظهار زر السلة",
      "default": true
    },
    {
      "type": "header",
      "content": "Announcement bar",
      "content_ar": "شريط الإعلانات"
    },
    {
      "type": "paragraph",
      "content": "Add Announcement blocks to show a strip above the masthead. Scrolling messages loop and pause on hover; shoppers who prefer reduced motion see them still.",
      "content_ar": "ضيف بلوكات إعلان عشان يظهر شريط فوق الهيدر. الرسائل المتحركة بتلف وبتقف لما الماوس يعدي عليها؛ واللي مفعّل تقليل الحركة بيشوفها ثابتة."
    },
    {
      "type": "checkbox",
      "id": "announcement_scroll",
      "label": "Scroll the messages",
      "label_ar": "تحريك الرسائل",
      "default": true
    },
    {
      "type": "range",
      "id": "announcement_speed",
      "label": "Seconds per loop",
      "label_ar": "ثواني اللفة الواحدة",
      "default": 35,
      "min": 10,
      "max": 90,
      "step": 5
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Menu link",
      "name_ar": "لينك في القائمة",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "label_ar": "الاسم",
          "default": "USED"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "label_ar": "الرابط",
          "default": "/products"
        },
        {
          "type": "checkbox",
          "id": "show_caret",
          "label": "Show the dropdown arrow",
          "label_ar": "إظهار سهم القائمة",
          "default": false
        }
      ]
    },
    {
      "type": "announcement",
      "name": "Announcement",
      "name_ar": "إعلان",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "label_ar": "الرسالة",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "label_ar": "الرابط",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Masthead",
      "name_ar": "الهيدر",
      "settings": {
        "strapline": "CITY of BOOKS",
        "show_search": true,
        "show_wishlist": true,
        "show_account": true,
        "show_cart": true,
        "announcement_scroll": true,
        "announcement_speed": 35
      }
    }
  ]
}
