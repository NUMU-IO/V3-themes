{
  "type": "pw-featured",
  "name": "Books + banner",
  "name_ar": "كتب + بانر",
  "settings": [
    {
      "type": "paragraph",
      "content": "A row of book tiles under a heading, with one promo banner beside it. The banner shows only when you give it a title or an image.",
      "content_ar": "صف كتب تحت عنوان، وجنبه بانر عرض واحد. البانر بيظهر بس لما تحط له عنوان أو صورة."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "label_ar": "العنوان",
      "default": "Newly released"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Which books",
      "label_ar": "أي كتب",
      "default": "newest",
      "options": [
        {
          "value": "newest",
          "label": "Newest first",
          "label_ar": "الأحدث"
        },
        {
          "value": "sale",
          "label": "Reduced",
          "label_ar": "المخفّض"
        },
        {
          "value": "cheapest",
          "label": "Cheapest first",
          "label_ar": "الأرخص"
        },
        {
          "value": "collection",
          "label": "From one collection",
          "label_ar": "من تصنيف واحد"
        },
        {
          "value": "books",
          "label": "Books I choose",
          "label_ar": "كتب أختارها"
        }
      ]
    },
    {
      "type": "text",
      "id": "collection",
      "label": "Collection",
      "label_ar": "التصنيف",
      "default": "",
      "info": "The collection's name or handle.",
      "info_ar": "اسم التصنيف أو معرّفه.",
      "visible_if": "{{ section.settings.source == 'collection' }}"
    },
    {
      "type": "product_list",
      "id": "books",
      "label": "Books",
      "label_ar": "الكتب",
      "default": [],
      "max_items": 8,
      "info": "Shown in the order you pick them, up to 8.",
      "info_ar": "بتظهر بنفس ترتيب اختيارك، لحد 8 كتب.",
      "visible_if": "{{ section.settings.source == 'books' }}"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "How many books",
      "label_ar": "عدد الكتب",
      "default": 3,
      "min": 2,
      "max": 8,
      "step": 1,
      "visible_if": "{{ section.settings.source != 'books' }}"
    },
    {
      "type": "header",
      "content": "Promo banner",
      "content_ar": "بانر العرض"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show the banner",
      "label_ar": "إظهار البانر",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_product",
      "label": "Book to feature",
      "label_ar": "الكتاب المميز",
      "default": "",
      "info": "The book's handle or exact title. Used when no banner image is uploaded. Leave empty to pick a book automatically.",
      "info_ar": "معرّف الكتاب أو عنوانه بالظبط. بيستخدم لو مفيش صورة بانر. سيبه فاضي عشان يختار كتاب تلقائي."
    },
    {
      "type": "text",
      "id": "promo_eyebrow",
      "label": "Small line above",
      "label_ar": "السطر الصغير فوق",
      "default": ""
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Banner title",
      "label_ar": "عنوان البانر",
      "default": ""
    },
    {
      "type": "text",
      "id": "promo_button",
      "label": "Button",
      "label_ar": "الزر",
      "default": ""
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Banner link",
      "label_ar": "رابط البانر",
      "default": "/products"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Banner image",
      "label_ar": "صورة البانر",
      "default": "",
      "info": "Upload an image to run your own banner with the title, line and button above. Leave it empty and the card shows a real book from your shop, with its cover, its name and a Buy now button.",
      "info_ar": "ارفع صورة عشان يظهر البانر بتاعك بالعنوان والسطر والزر اللي فوق. سيبها فاضية والكارت هيعرض كتاب حقيقي من متجرك بغلافه واسمه وزر اشتري دلوقتي."
    }
  ],
  "presets": [
    {
      "name": "Books + banner",
      "name_ar": "كتب + بانر",
      "settings": {
        "heading": "Newly released",
        "source": "newest",
        "limit": 3,
        "show_promo": true
      }
    }
  ]
}
