{
  "type": "pw-product",
  "name": "Book page",
  "name_ar": "صفحة الكتاب",
  "settings": [
    {
      "type": "paragraph",
      "content": "Each option axis on the book (Format, Paper, Condition…) is shown as a row of chips, so the shopper picks one value per axis. Books whose variants have no options are shown as a list of priced editions instead. The bibliographic rows come from the bookstore custom fields (books.isbn, books.publisher, books.pages, …).",
      "content_ar": "كل اختيار على الكتاب (النوع، الورق، الحالة…) بيظهر كصف أزرار، والزبون بيختار قيمة من كل صف. الكتب اللي متغيراتها من غير اختيارات بتظهر كقائمة نسخ بأسعارها. وبيانات الكتاب بتيجي من الحقول المخصصة (books.isbn وbooks.publisher وbooks.pages)."
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Breadcrumb: home",
      "label_ar": "مسار: الرئيسية",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "listing_label",
      "label": "Breadcrumb: listing",
      "label_ar": "مسار: القائمة",
      "default": "Books"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show the rating",
      "label_ar": "إظهار التقييم",
      "default": true,
      "info": "Reads books.rating and books.rating_count.",
      "info_ar": "بيقرأ books.rating وbooks.rating_count."
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show the wishlist button",
      "label_ar": "إظهار زر المفضلة",
      "default": true
    },
    {
      "type": "range",
      "id": "low_stock_at",
      "label": "Warn when copies drop to",
      "label_ar": "تحذير لما النسخ توصل",
      "default": 5,
      "min": 1,
      "max": 20,
      "step": 1
    },
    {
      "type": "header",
      "content": "Delivery estimate",
      "content_ar": "ميعاد التوصيل"
    },
    {
      "type": "checkbox",
      "id": "show_eta",
      "label": "Show \"Order today, arrives …\"",
      "label_ar": "إظهار \"اطلب النهارده، يوصل …\"",
      "default": true
    },
    {
      "type": "range",
      "id": "delivery_min_days",
      "label": "Earliest delivery, in days",
      "label_ar": "أقرب توصيل بالأيام",
      "default": 2,
      "min": 0,
      "max": 30,
      "step": 1
    },
    {
      "type": "range",
      "id": "delivery_max_days",
      "label": "Latest delivery, in days",
      "label_ar": "أبعد توصيل بالأيام",
      "default": 5,
      "min": 0,
      "max": 45,
      "step": 1
    },
    {
      "type": "text",
      "id": "secure_text",
      "label": "Secure checkout line",
      "label_ar": "سطر الدفع الآمن",
      "default": ""
    },
    {
      "type": "header",
      "content": "Reassurance",
      "content_ar": "الضمانات"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show shipping, returns and care notes",
      "label_ar": "إظهار الشحن والإرجاع والتغليف",
      "default": true,
      "info": "Leave a text empty to use the built-in wording in the shopper's language.",
      "info_ar": "سيب أي نص فاضي عشان يستخدم الصياغة الجاهزة بلغة الزبون."
    },
    {
      "type": "text",
      "id": "trust_shipping_title",
      "label": "Shipping",
      "label_ar": "الشحن",
      "default": ""
    },
    {
      "type": "text",
      "id": "trust_shipping_text",
      "label": "Shipping detail",
      "label_ar": "تفاصيل الشحن",
      "default": ""
    },
    {
      "type": "text",
      "id": "trust_returns_title",
      "label": "Returns",
      "label_ar": "الإرجاع",
      "default": ""
    },
    {
      "type": "text",
      "id": "trust_returns_text",
      "label": "Returns detail",
      "label_ar": "تفاصيل الإرجاع",
      "default": ""
    },
    {
      "type": "text",
      "id": "trust_quality_title",
      "label": "Care",
      "label_ar": "التغليف",
      "default": ""
    },
    {
      "type": "text",
      "id": "trust_quality_text",
      "label": "Care detail",
      "label_ar": "تفاصيل التغليف",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "quality_text",
      "label": "Quality tab text",
      "label_ar": "نص تبويب الجودة",
      "default": "",
      "info": "How you grade and check copies. Leave empty for the built-in wording in the shopper's language.",
      "info_ar": "إزاي بتقيّم وتراجع النسخ. سيبه فاضي عشان يستخدم الصياغة الجاهزة بلغة الزبون."
    },
    {
      "type": "textarea",
      "id": "delivery_text",
      "label": "Delivery tab text",
      "label_ar": "نص تبويب التوصيل",
      "default": "",
      "info": "Extra delivery details shown under shipping and returns.",
      "info_ar": "تفاصيل توصيل إضافية بتظهر تحت الشحن والإرجاع."
    },
    {
      "type": "header",
      "content": "Recently viewed",
      "content_ar": "شفتها مؤخرًا"
    },
    {
      "type": "checkbox",
      "id": "show_recent",
      "label": "Show recently viewed books",
      "label_ar": "إظهار الكتب اللي اتشافت مؤخرًا",
      "default": true,
      "info": "Kept in the shopper's own browser — nothing is sent to the store.",
      "info_ar": "بيتحفظ في متصفح الزبون بس — مفيش حاجة بتتبعت للمتجر."
    },
    {
      "type": "text",
      "id": "recent_title",
      "label": "Heading",
      "label_ar": "العنوان",
      "default": "",
      "info": "Leave empty to use the built-in wording in the shopper's language.",
      "info_ar": "سيبه فاضي عشان يستخدم الصياغة الجاهزة بلغة الزبون."
    },
    {
      "type": "range",
      "id": "recent_limit",
      "label": "How many",
      "label_ar": "العدد",
      "default": 5,
      "min": 3,
      "max": 8,
      "step": 1
    },
    {
      "type": "header",
      "content": "Staff pick",
      "content_ar": "اختيار الفريق"
    },
    {
      "type": "text",
      "id": "staff_pick_title",
      "label": "Heading",
      "label_ar": "العنوان",
      "default": "A Staff Pick"
    },
    {
      "type": "textarea",
      "id": "staff_pick_text",
      "label": "Note",
      "label_ar": "الملاحظة",
      "default": ""
    },
    {
      "type": "text",
      "id": "staff_pick_by",
      "label": "Signed",
      "label_ar": "التوقيع",
      "default": "",
      "info": "A bookseller's name. The per-book fields books.staff_pick and books.staff_pick_by override these.",
      "info_ar": "اسم البائع. الحقول books.staff_pick وbooks.staff_pick_by بتتغلب على دول."
    },
    {
      "type": "header",
      "content": "Also bought",
      "content_ar": "اشتروا كمان"
    },
    {
      "type": "text",
      "id": "related_title",
      "label": "Heading",
      "label_ar": "العنوان",
      "default": "Customers Also Bought"
    },
    {
      "type": "range",
      "id": "related_limit",
      "label": "How many",
      "label_ar": "العدد",
      "default": 5,
      "min": 3,
      "max": 6,
      "step": 1
    },
    {
      "type": "text",
      "id": "no_product_hint",
      "label": "Editor hint",
      "label_ar": "تلميح المحرر",
      "default": "Open a book to preview this page."
    }
  ],
  "presets": [
    {
      "name": "Book page",
      "name_ar": "صفحة الكتاب",
      "settings": {
        "show_rating": true,
        "show_wishlist": true,
        "show_trust": true,
        "low_stock_at": 5,
        "related_limit": 5
      }
    }
  ]
}
