{
  "type": "pw-gifts",
  "name": "Gift guide",
  "name_ar": "دليل الهدايا",
  "settings": [
    {
      "type": "paragraph",
      "content": "A gift table for the home page or a gifts page: what you offer gift buyers, a few books picked for giving, and ways in by who it's for or what it costs. Shoppers add gift wrap and a card message at checkout — switch those on in the Checkout section.",
      "content_ar": "ترابيزة هدايا للصفحة الرئيسية أو صفحة الهدايا: اللي بتقدمه لمشتري الهدايا، وكام كتاب مختارين للإهداء، وطرق للتصفح حسب الشخص أو السعر. الزبون بيضيف تغليف الهدية ورسالة الكارت في صفحة الدفع — فعّلهم من قسم إتمام الشراء."
    },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "label_ar": "السطر الصغير فوق", "default": "GIFTS" },
    { "type": "text", "id": "heading", "label": "Heading", "label_ar": "العنوان", "default": "Give a book they'll keep" },
    { "type": "textarea", "id": "body", "label": "Text", "label_ar": "النص", "default": "" },
    {
      "type": "textarea",
      "id": "perks",
      "label": "What gift buyers get",
      "label_ar": "اللي بياخده مشتري الهدية",
      "default": "",
      "info": "One per line. Only list what you really offer.",
      "info_ar": "كل ميزة في سطر. اكتب بس اللي بتقدمه فعلًا."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Which books",
      "label_ar": "أي كتب",
      "default": "collection",
      "options": [
        { "value": "collection", "label": "From one collection", "label_ar": "من تصنيف واحد" },
        { "value": "books", "label": "Books I choose", "label_ar": "كتب أختارها" },
        { "value": "newest", "label": "Newest first", "label_ar": "الأحدث" },
        { "value": "sale", "label": "Reduced", "label_ar": "المخفّض" },
        { "value": "under", "label": "Under a price", "label_ar": "أقل من سعر" }
      ]
    },
    {
      "type": "text",
      "id": "collection",
      "label": "Collection",
      "label_ar": "التصنيف",
      "default": "gifts",
      "info": "The collection's name or handle.",
      "info_ar": "اسم التصنيف أو معرّفه.",
      "visible_if": "{{ section.settings.source == 'collection' }}"
    },
    {
      "type": "textarea",
      "id": "books",
      "label": "Books",
      "label_ar": "الكتب",
      "default": "",
      "info": "Book handles or exact titles, one per line, in the order to show them.",
      "info_ar": "معرّفات الكتب أو عناوينها بالظبط، كل كتاب في سطر، بالترتيب اللي عايزه.",
      "visible_if": "{{ section.settings.source == 'books' }}"
    },
    {
      "type": "range",
      "id": "max_price",
      "label": "Under this price",
      "label_ar": "أقل من السعر ده",
      "default": 200,
      "min": 50,
      "max": 3000,
      "step": 10,
      "visible_if": "{{ section.settings.source == 'under' }}"
    },
    { "type": "range", "id": "limit", "label": "How many books", "label_ar": "عدد الكتب", "default": 3, "min": 1, "max": 4, "step": 1 },
    {
      "type": "select",
      "id": "tone",
      "label": "Colour",
      "label_ar": "اللون",
      "default": "lavender",
      "options": [
        { "value": "night", "label": "Midnight", "label_ar": "ليلي" },
        { "value": "lavender", "label": "Lavender", "label_ar": "بنفسجي فاتح" },
        { "value": "paper", "label": "Paper", "label_ar": "ورقي" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Photograph", "label_ar": "الصورة", "default": "", "info": "Without one, a gift drawing is shown.", "info_ar": "من غير صورة، بتظهر رسمة هدية." },
    { "type": "text", "id": "cta_text", "label": "Button", "label_ar": "الزر", "default": "Shop gifts" },
    { "type": "url", "id": "cta_link", "label": "Button link", "label_ar": "رابط الزر", "default": "/collections/gifts" }
  ],
  "blocks": [
    {
      "type": "way",
      "name": "Way in",
      "name_ar": "طريقة تصفح",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "label_ar": "الاسم", "default": "For the reader who has everything" },
        { "type": "text", "id": "note", "label": "Small line", "label_ar": "سطر صغير", "default": "" },
        { "type": "url", "id": "link", "label": "Link", "label_ar": "الرابط", "default": "/collections/gifts" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift guide",
      "name_ar": "دليل الهدايا",
      "settings": {
        "eyebrow": "GIFTS",
        "heading": "Give a book they'll keep",
        "body": "Picked by the people who shelve them, wrapped by hand if you like.",
        "source": "collection",
        "collection": "gifts",
        "limit": 3,
        "tone": "lavender",
        "cta_text": "Shop gifts",
        "cta_link": "/collections/gifts"
      },
      "blocks": [
        { "type": "way", "settings": { "label": "For young readers", "link": "/collections/children" } },
        { "type": "way", "settings": { "label": "Collector's editions", "link": "/collections/limited-editions" } },
        { "type": "way", "settings": { "label": "Gift cards", "note": "They choose the book", "link": "/collections/gifts" } }
      ]
    }
  ]
}
