{
  "type": "gn-product-rail",
  "name": "Product rail",
  "name_ar": "شريط منتجات",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "label_ar": "العنوان",
      "default": "New in"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "“View all” link",
      "label_ar": "رابط “شوف الكل”",
      "default": "/products"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Which products",
      "label_ar": "المنتجات المعروضة",
      "default": "newest",
      "options": [
        {
          "value": "newest",
          "label": "Newest first",
          "label_ar": "الأحدث"
        },
        {
          "value": "category",
          "label": "From one category",
          "label_ar": "من تصنيف واحد"
        },
        {
          "value": "product_list",
          "label": "Products I pick",
          "label_ar": "منتجات أختارها"
        }
      ]
    },
    {
      "type": "collection",
      "id": "category",
      "label": "Category",
      "label_ar": "التصنيف",
      "default": "",
      "visible_if": "source == 'category'"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "label_ar": "المنتجات",
      "default": [],
      "info": "Shown in the order you arrange them here.",
      "info_ar": "بتظهر بالترتيب اللي ترتبيه هنا.",
      "visible_if": "source == 'product_list'"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "How many",
      "label_ar": "العدد",
      "default": 8,
      "min": 2,
      "max": 24,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards across (desktop)",
      "label_ar": "عدد الكروت في الصف",
      "default": 3,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show previous / next buttons",
      "label_ar": "إظهار أزرار السابق والتالي",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "label_ar": "إظهار الإضافة السريعة",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_label",
      "label": "Show the colour label",
      "label_ar": "إظهار اسم اللون",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product rail",
      "name_ar": "شريط منتجات",
      "settings": {
        "source": "newest",
        "heading": "New in"
      }
    }
  ]
}
