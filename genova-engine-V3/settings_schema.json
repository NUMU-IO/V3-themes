        "default": "#9A9A9A"
      },
      {
        "type": "header",
        "content": "Lines",
        "content_ar": "الخطوط"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Hairline",
        "label_ar": "الخط الفاصل",
        "info": "Genova has no shadows — every edge in the theme is one of these lines.",
        "info_ar": "الثيم من غير ظلال خالص — كل الحدود في التصميم هي الخطوط دي.",
        "default": "#E2E0DC"
      },
      {
        "type": "color",
        "id": "color_line_strong",
        "label": "Strong line (selected states)",
        "label_ar": "الخط القوي (العناصر المختارة)",
        "default": "#C9C6C1"
      },
      {
