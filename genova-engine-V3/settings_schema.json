[
  {
    "name": "Brand",
    "name_ar": "العلامة التجارية",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "label_ar": "الشعار",
        "info": "Shown in the header and footer. Leave empty to use the store name as a wordmark — Genova is designed to look right either way.",
        "info_ar": "يظهر في الهيدر والفوتر. سيبه فاضي وهيستخدم اسم المتجر كنص — التصميم شغال بالطريقتين.",
        "default": ""
      },
      {
        "type": "select",
        "id": "logo_shape",
        "label": "Logo shape",
        "label_ar": "شكل الشعار",
        "default": "none",
        "info": "Crops the logo into a shape. 'Original' keeps it untouched — the right choice for a wordmark.",
        "info_ar": "بيقص الشعار في شكل. \"الأصلي\" بيسيبه زي ما هو — وده الأنسب للشعار الكتابي.",
        "options": [
          {
            "value": "none",
            "label": "Original",
            "label_ar": "الأصلي"
          },
          {
            "value": "square",
            "label": "Square",
            "label_ar": "مربع"
          },
          {
            "value": "rounded",
            "label": "Rounded square",
            "label_ar": "مربع بزوايا دائرية"
          },
          {
            "value": "circle",
            "label": "Circle",
            "label_ar": "دائرة"
          }
        ]
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "label_ar": "عرض الشعار",
        "default": 48,
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "info": "Sets the logo's size. The header grows to fit a larger logo.",
        "info_ar": "بيحدد حجم الشعار. الهيدر بيكبر لو الشعار أكبر."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (browser tab icon)",
        "label_ar": "أيقونة المتصفح",
        "default": ""
      }
    ]
  },
  {
    "name": "Colors",
    "name_ar": "الألوان",
    "settings": [
      {
        "type": "paragraph",
        "content": "Genova is a strict monochrome theme — there is no accent colour by design. Hierarchy comes from type weight, space and hairlines; the only colour on the page is your product photography. Changing these to a coloured palette will work, but it is not what the theme was drawn for.",
        "content_ar": "جينوفا ثيم أبيض وأسود بالكامل عن قصد — مفيش لون مميز. الترتيب البصري بيتعمل بحجم ووزن الخط والمسافات والخطوط الرفيعة، واللون الوحيد في الصفحة هو صور المنتجات. تقدر تغيّرهم لألوان، بس ده مش اللي الثيم اتصمم عليه."
      },
      {
        "type": "header",
        "content": "Surfaces",
        "content_ar": "الخلفيات"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Page background",
        "label_ar": "خلفية الصفحة",
        "default": "#F5F4F2"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card & panel background",
        "label_ar": "خلفية الكروت والقوائم",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_media",
        "label": "Image plate",
        "label_ar": "خلفية الصور",
        "info": "Sits behind product photos while they load and shows through transparent PNGs.",
        "info_ar": "بيظهر ورا صور المنتجات وهي بتحمّل، وكمان من ورا الصور الشفافة.",
        "default": "#EDEBE8"
      },
      {
        "type": "header",
        "content": "Text",
        "content_ar": "النصوص"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Ink (headings & body)",
        "label_ar": "لون النص الأساسي",
        "default": "#141414"
      },
      {
        "type": "color",
        "id": "color_ink_soft",
        "label": "Ink — hover / pressed",
        "label_ar": "لون النص عند المرور",
        "default": "#3A3A3A"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text (prices, captions)",
