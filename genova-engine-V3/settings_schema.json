      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale / discount colour",
        "label_ar": "لون التخفيض",
        "info": "Used for sale badges, discounted prices and low-stock warnings. Set it to your text colour for a fully monochrome store.",
        "default": "#c81e1e"
      },
      {
        "type": "color",
        "id": "color_sale_fg",
        "label": "Sale badge text",
        "label_ar": "لون نص التخفيض",
        "default": "#ffffff"
      }
    ]
  },
