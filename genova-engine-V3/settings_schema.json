  {
    "name": "Layout",
    "name_ar": "التخطيط",
    "settings": [
      {
        "type": "select",
        "id": "container_width",
        "label": "Maximum content width",
        "label_ar": "أقصى عرض للمحتوى",
        "default": "1600px",
        "info": "Genova is a wide, edge-aware layout. Narrower widths make it read more like a classic boutique.",
        "info_ar": "جينوفا تخطيط عريض. العرض الأصغر بيخلي الشكل أقرب للبوتيك الكلاسيكي.",
        "options": [
          {
            "value": "1280px",
            "label": "Narrow",
            "label_ar": "ضيق"
          },
          {
            "value": "1440px",
            "label": "Medium",
            "label_ar": "متوسط"
          },
